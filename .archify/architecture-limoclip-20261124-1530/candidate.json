  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "双击房间 → 工作区解析 → 六平台 Provider 给出流地址 → libmpv 多窗格播放",
        "断流不判未开播：显示「重连中」，按 3/10/30 秒退避重试并重新解析地址"
      ]
    },
    {
      "dot": "emerald",
      "title": "录制与剪辑",
      "items": [
        "每次 FFmpeg 只录一段，停止时按墙钟起点裁剪 CDN 重发重叠并 concat 合并",
        "剪辑台提供音频/弹幕双波形、弹幕 ASS 与带弹幕/干净双版 MP4 导出"
      ]
    },
    {
      "dot": "violet",
      "title": "插件与热更新",
      "items": [
        "六平台全部内置为插件（单 DLL）；外部插件经 Ed25519 验签后才加载",
        "清单 GitHub Raw → Gitee 镜像回退；DLL 支持 mirrorDownloadUrl 主备下载"
      ]
    },
    {
      "dot": "amber",
      "title": "本地优先",
      "items": [
        "房间、布局方案、录制会话与 ASR Key 全部保存在本机 SQLite",
        "平台 Cookie 经 Windows DPAPI 加密，不经过任何第三方账号服务器"
      ]
    },
    {
      "dot": "rose",
      "title": "外部依赖与限制",
      "items": [
        "虎牙等 CDN 单连接只稳定数秒，依赖分段录制与自动重连策略",
        "YouTube / Twitch 依赖 yt-dlp 与网络可达性；ASR 与插件源需要联网"
      ]
    }
  ]
