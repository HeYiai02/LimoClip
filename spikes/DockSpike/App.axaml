<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Themes.Fluent"
             xmlns:mvvm="using:Dock.Model.Mvvm.Controls"
             xmlns:dockCtl="using:Dock.Avalonia.Controls"
             x:Class="DockSpike.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ControlTheme x:Key="{x:Type dockCtl:ToolDockControl}" TargetType="dockCtl:ToolDockControl">
      <Setter Property="Template">
        <ControlTemplate>
          <dockCtl:DockableControl TrackingMode="Visible"
                                   Background="{TemplateBinding Background}">
            <dockCtl:ToolControl />
          </dockCtl:DockableControl>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type dockCtl:ToolControl}" TargetType="dockCtl:ToolControl">
      <Setter Property="Template">
        <ControlTemplate>
          <ContentControl Content="{ReflectionBinding ActiveDockable.Context}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Application.Resources>
  <Application.DataTemplates>
    <DataTemplate DataType="mvvm:Tool">
      <ContentControl Content="{Binding Context}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <dock:DockFluentTheme />
  </Application.Styles>
</Application>
