<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <RootNamespace>LiveMonitor.Desktop</RootNamespace>
    <AssemblyName>LimoClip</AssemblyName>
    <Product>LimoClip</Product>
    <AssemblyTitle>LimoClip</AssemblyTitle>
    <Description>多平台直播监控、录制与弹幕高能剪辑工作台</Description>
    <Company>LimoClip</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- WorkspacePlayerManager 的可注入播放器工厂是 internal 测试接缝，仅对桌面测试工程开放。 -->
    <InternalsVisibleTo Include="LiveMonitor.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Semi.Avalonia" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dock.Avalonia" Version="$(DockVersion)" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="$(DockVersion)" />
    <PackageReference Include="Dock.Model.Mvvm" Version="$(DockVersion)" />
    <PackageReference Include="Dock.Serializer.SystemTextJson" Version="$(DockVersion)" />
    <PackageReference Include="LibMpv.Avalonia" Version="1.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveMonitor.Core\LiveMonitor.Core.csproj" />
    <ProjectReference Include="..\LiveMonitor.Data\LiveMonitor.Data.csproj" />
    <ProjectReference Include="..\LiveMonitor.Danmaku\LiveMonitor.Danmaku.csproj" />
    <ProjectReference Include="..\LiveMonitor.Media\LiveMonitor.Media.csproj" />
    <ProjectReference Include="..\LiveMonitor.Platforms\LiveMonitor.Platforms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tools\libmpv-2.dll')" />
    <None Include="..\..\tools\yt-dlp.exe" Link="yt-dlp.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tools\yt-dlp.exe')" />
    <None Include="..\..\tools\cacert.crt" Link="cacert.crt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tools\cacert.crt')" />
    <None Include="..\..\tools\ffmpeg\ffmpeg.exe" Link="tools\ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tools\ffmpeg\ffmpeg.exe')" />
  </ItemGroup>
</Project>
