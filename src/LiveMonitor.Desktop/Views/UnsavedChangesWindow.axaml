<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveMonitor.Desktop.Views.UnsavedChangesWindow"
        Icon="avares://LimoClip/Assets/AppIcon.ico"
        Title="切换方案"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BrushBgBase}">
  <StackPanel>
    <!-- 标题区 -->
    <StackPanel Margin="20,18,20,10" Spacing="6">
      <TextBlock Text="当前方案有未保存的修改"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushTextPrimary}" />
      <TextBlock Margin="0,2,0,0" TextWrapping="Wrap"
                 FontSize="11.5"
                 Foreground="{DynamicResource BrushTextSecondary}"
                 Text="切换前是否保存？保存会覆盖当前方案；放弃修改会丢失本次调整。" />
    </StackPanel>

    <!-- 操作栏 -->
    <Border BorderBrush="{DynamicResource BrushBorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CancelButton" Content="取消" Classes="subtle-btn" Click="OnCancel" />
        <Button x:Name="DiscardButton" Content="放弃修改" Classes="ghost-btn" Click="OnDiscard" />
        <Button x:Name="SaveButton" Content="保存并切换" Classes="primary-btn" Click="OnSave" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
