<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveMonitor.Desktop.Views.SettingsWindow"
        Title="账号与设置"
        Width="720" Height="620"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#0F1115">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20">
    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,14">
      <TextBlock Text="账号与设置" FontSize="20" FontWeight="SemiBold" Foreground="#E6E8EE" />
      <TextBlock Text="登录态只保存在本机 DPAPI 加密的 PlatformCredentials 中。"
                 FontSize="11" Foreground="#7C8596" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Background="#151923" BorderBrush="#262B36" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="10">
            <TextBlock Text="平台账号" FontSize="13" FontWeight="SemiBold" Foreground="#E6E8EE" />
            <StackPanel x:Name="AccountRowsPanel" Spacing="6" />
            <TextBlock x:Name="AccountHint" FontSize="10" Foreground="#6B7484"
                       TextWrapping="Wrap"
                       Text="支持 B 站 / Twitch / YouTube / 虎牙 / 斗鱼 / 抖音。登录态只保存在本机，使用 DPAPI 加密；YouTube 登录用于 yt-dlp 获取登录态画质，其余平台登录可用于提升画质与风控通过率。" />
          </StackPanel>
        </Border>

        <Border Background="#151923" BorderBrush="#262B36" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="10">
            <TextBlock Text="语音识别（ASR）" FontSize="13" FontWeight="SemiBold" Foreground="#E6E8EE" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="识别服务"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AsrPresetBox" FontSize="12"
                        HorizontalAlignment="Stretch" SelectionChanged="OnAsrPresetChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                               ToolTip.Tip="{Binding Description}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="接口地址"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="AsrEndpointBox" FontSize="12"
                       Watermark="https://api.example.com/v1/audio/transcriptions" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="模型"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="AsrModelBox" FontSize="12"
                       Watermark="例如 FunAudioLLM/SenseVoiceSmall" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="语言"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <ComboBox Grid.Row="3" Grid.Column="1" x:Name="AsrLanguageBox" FontSize="12"
                        HorizontalAlignment="Stretch" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="API Key"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <TextBox Grid.Row="4" Grid.Column="1" x:Name="AsrApiKeyBox" FontSize="12"
                       PasswordChar="●" Watermark="粘贴 API Key" />
            </Grid>
            <TextBlock x:Name="AsrPresetDescriptionText" FontSize="10" Foreground="#6B7484"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="AsrSaveButton" Content="保存" FontSize="11" Padding="12,4"
                      Click="OnSaveAsrSettings" />
              <Button x:Name="AsrTestButton" Content="测试连接" FontSize="11" Padding="10,4"
                      Click="OnTestAsrConnection" />
            </StackPanel>
            <TextBlock x:Name="AsrStatusText" FontSize="10" Foreground="#7C8596"
                       TextWrapping="Wrap" Text="尚未读取语音识别设置。" />
            <TextBlock FontSize="10" Foreground="#6B7484" TextWrapping="Wrap"
                       Text="API Key 使用 Windows DPAPI 加密保存，仅当前 Windows 用户可解密，不会写入日志或明文数据库。「测试连接」只验证当前表单内容、不落盘；自定义服务需填写 OpenAI 兼容的 /audio/transcriptions 接口地址。" />
          </StackPanel>
        </Border>

        <Border Background="#151923" BorderBrush="#262B36" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="10">
            <TextBlock Text="组件与插件更新" FontSize="13" FontWeight="SemiBold" Foreground="#E6E8EE" />
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto"
                  ColumnSpacing="10" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="yt-dlp"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <TextBlock Grid.Row="0" Grid.Column="1" x:Name="YtDlpVersionText" Margin="12,0"
                         FontSize="11" Foreground="#7C8596" VerticalAlignment="Center"
                         Text="尚未检查" />
              <Button Grid.Row="0" Grid.Column="2" x:Name="CheckYtDlpButton" Content="检查更新"
                      FontSize="11" Padding="10,4" Click="OnCheckYtDlpUpdate" />
              <Button Grid.Row="0" Grid.Column="3" x:Name="InstallYtDlpButton" Content="下载并更新"
                      FontSize="11" Padding="10,4" IsEnabled="False" Click="OnInstallYtDlpUpdate" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="平台插件"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PluginUpdateSummaryText" Margin="12,0"
                         FontSize="11" Foreground="#7C8596" VerticalAlignment="Center"
                         Text="尚未检查（内置 B 站 / Twitch / YouTube / 虎牙 / 斗鱼 / 抖音）" TextWrapping="Wrap" />
              <Button Grid.Row="1" Grid.Column="2" x:Name="CheckPluginsButton" Content="检查插件更新"
                      FontSize="11" Padding="10,4" Click="OnCheckPluginUpdates" />
              <Button Grid.Row="1" Grid.Column="3" x:Name="InstallPluginsButton" Content="下载并安装"
                      FontSize="11" Padding="10,4" IsEnabled="False" Click="OnInstallPluginUpdates" />
            </Grid>
            <TextBlock x:Name="UpdateStatusText" FontSize="10" Foreground="#7C8596"
                       TextWrapping="Wrap" Text="更新组件会从 GitHub 下载，需要联网。" />
            <TextBlock FontSize="10" Foreground="#6B7484" TextWrapping="Wrap"
                       Text="平台插件包使用 Ed25519 签名校验，验签不通过会被拒绝加载；插件在无录制/弹幕任务时立即生效，否则下次启动生效。yt-dlp 更新会先下载到临时文件并校验，再原子替换 tools 目录内的 exe。" />
          </StackPanel>
        </Border>

        <Border Background="#151923" BorderBrush="#262B36" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="10">
            <TextBlock Text="弹幕屏蔽词库" FontSize="13" FontWeight="SemiBold" Foreground="#E6E8EE" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" x:Name="KeywordBox"
                       Watermark="输入要屏蔽的关键词 / 正则表达式" FontSize="12" />
              <CheckBox Grid.Column="1" x:Name="KeywordIsRegexCheck" Content="正则"
                        FontSize="11" VerticalAlignment="Center"
                        ToolTip.Tip="勾选后按 .NET 正则表达式匹配弹幕内容" />
              <Button Grid.Column="2" Content="添加" FontSize="11" Padding="12,4"
                      Click="OnAddKeyword" />
            </Grid>
            <ListBox x:Name="KeywordList" Height="150" FontSize="11">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Keyword}" Foreground="#D5DAE4" />
                    <TextBlock Grid.Column="1" Text="正则" IsVisible="{Binding IsRegex}"
                               FontSize="10" Foreground="#FB7299" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="删除选中" FontSize="11" Padding="10,4" Click="OnRemoveKeyword" />
              <CheckBox x:Name="UnicycleToggle" Content="开启独轮车自动屏蔽"
                        FontSize="11" VerticalAlignment="Center"
                        Checked="OnUnicycleChanged" Unchecked="OnUnicycleChanged" />
            </StackPanel>
            <CheckBox x:Name="DanmakuPreviewToggle" Content="监控画面弹幕预览"
                      FontSize="11" VerticalAlignment="Center"
                      Checked="OnDanmakuPreviewChanged" Unchecked="OnDanmakuPreviewChanged" />
            <CheckBox x:Name="DanmakuStickerToggle" Content="渲染纯表情包弹幕（关闭后仅统计与高能检测）"
                      FontSize="11" VerticalAlignment="Center"
                      Checked="OnDanmakuStickerChanged" Unchecked="OnDanmakuStickerChanged" />
            <CheckBox x:Name="DanmakuEmoteImagesToggle" Content="显示表情图片（静态，多屏时建议关闭）"
                      FontSize="11" VerticalAlignment="Center"
                      Checked="OnDanmakuEmoteImagesChanged" Unchecked="OnDanmakuEmoteImagesChanged" />
            <TextBlock FontSize="10" Foreground="#6B7484" TextWrapping="Wrap"
                       Text="支持包含匹配与正则（勾选「正则」）。实时过滤已接入 V0.2；独轮车规则仅对 B 站生效。默认行内表情按 [表情] 文本显示、纯大表情包显示为 [表情名]；勾选「显示表情图片」后会把命中表情渲染成静态小图（不跑 GIF/动画）。" />
          </StackPanel>
        </Border>

        <Border Background="#151923" BorderBrush="#262B36" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="10">
            <TextBlock Text="高能事件检测" FontSize="13" FontWeight="SemiBold" Foreground="#E6E8EE" />
            <Grid ColumnDefinitions="Auto,140" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="12" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="短窗（秒）"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="HighlightShortWindow"
                             Minimum="1" Maximum="600" Increment="1" FormatString="0" FontSize="11" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="基线窗（秒）"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="HighlightBaselineWindow"
                             Minimum="1" Maximum="3600" Increment="10" FormatString="0" FontSize="11" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="密度倍数"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="HighlightDensityMultiplier"
                             Minimum="0.1" Maximum="1000" Increment="0.5" FormatString="0.0##" FontSize="11" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="短窗最少条数"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="HighlightMinShortWindowCount"
                             Minimum="1" Maximum="1000000" Increment="1" FormatString="0" FontSize="11" />
              <TextBlock Grid.Row="4" Grid.Column="0" Text="冷却（秒）"
                         FontSize="11" Foreground="#A9B4C6" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="HighlightCooldownSeconds"
                             Minimum="0" Maximum="86400" Increment="10" FormatString="0" FontSize="11" />
            </Grid>
            <TextBlock Text="加权关键词（一行一个，命中后按 1.5 条计）"
                       FontSize="11" Foreground="#A9B4C6" />
            <TextBox x:Name="HighlightBoostKeywordsBox" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="72" FontSize="11" Watermark="666&#10;草&#10;神回&#10;Pog" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="保存高能参数" FontSize="11" Padding="12,4" Click="OnSaveHighlight" />
              <Button Content="恢复默认" FontSize="11" Padding="10,4" Click="OnResetHighlight" />
            </StackPanel>
            <TextBlock FontSize="10" Foreground="#6B7484" TextWrapping="Wrap"
                       Text="短窗密度达到基线的倍数、且短窗条数与绝对下限达标时触发；触发后进入冷却。参数保存在本机 AppSettings。" />
          </StackPanel>
        </Border>

        <Border Background="#151923" BorderBrush="#262B36" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="10">
            <TextBlock Text="Twitch 去广告（可选）" FontSize="13" FontWeight="SemiBold" Foreground="#E6E8EE" />
            <TextBlock FontSize="10" Foreground="#7C8596" TextWrapping="Wrap"
                       Text="Twitch 直播流内会插播广告。可填写外部去广告 M3U8 代理模板：用占位符 channel 代表频道名，例如 https://eu.luminous.dev/live/channel。留空时使用内置的原生 GQL + Usher 播放列表（可去广告），失败会自动回退 yt-dlp。" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" x:Name="TwitchProxyBox" FontSize="11"
                       Watermark="留空 = 仅使用内置原生播放列表（推荐先留空）" />
              <Button Grid.Column="1" Content="保存" FontSize="11" Padding="14,4" Click="OnSaveTwitchProxy" />
            </Grid>
            <TextBlock FontSize="10" Foreground="#6B7484" TextWrapping="Wrap"
                       Text="代理只在播放 Twitch 时使用，不会转发登录 Cookie；代理不可用会自动降级，不影响其它平台。" />
          </StackPanel>
        </Border>

        <Border Background="#151923" BorderBrush="#262B36" BorderThickness="1"
                CornerRadius="8" Padding="14">
          <StackPanel Spacing="4">
            <TextBlock Text="安全说明" FontSize="13" FontWeight="SemiBold" Foreground="#E6E8EE" />
            <TextBlock FontSize="10" Foreground="#7C8596" TextWrapping="Wrap"
                       Text="Cookie 等同登录态。登录窗关闭后不会写入日志或数据库明文；DPAPI 仅当前 Windows 用户可解密。" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="11"
                 Foreground="#7C8596" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="关闭" FontSize="12" Padding="18,6"
              Click="OnClose" />
    </Grid>
  </Grid>
</Window>
