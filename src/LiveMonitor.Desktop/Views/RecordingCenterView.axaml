<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LiveMonitor.Desktop.Views"
             xmlns:vm="using:LiveMonitor.Desktop.ViewModels"
             x:Class="LiveMonitor.Desktop.Views.RecordingCenterView"
             Background="#0F1115">

    <UserControl.Resources>
        <local:StringToBrushConverter x:Key="Brush" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.rc">
            <Setter Property="Background" Value="#1B2130" />
            <Setter Property="BorderBrush" Value="#2C3444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#D5DBE5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button.rc:pointerover">
            <Setter Property="Background" Value="#232B3C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.rc:pressed">
            <Setter Property="Background" Value="#2E3850" />
        </Style>
        <Style Selector="Button.rc-xs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#2C3444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#A9B4C6" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="Button.rc-xs:pointerover">
            <Setter Property="Background" Value="#232B3C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- 顶部：全局目录 + 状态文本 -->
        <StackPanel Grid.Row="0" Spacing="10">
            <StackPanel Spacing="2">
                <TextBlock Text="录制中心" FontSize="20" FontWeight="SemiBold" Foreground="#E6E8EE" />
                <TextBlock Text="统一管理各直播间的录制与历史录像；录制在后台进行，切换视图不会中断。"
                           FontSize="11" Foreground="#7C8596" />
            </StackPanel>

            <Border Background="#151923" BorderBrush="#262B36" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <TextBlock Text="全局录像目录" FontSize="12" Foreground="#A9B4C6"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding GlobalDirectory}" FontSize="12"
                               Foreground="#E6E8EE" Margin="12,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding GlobalDirectory}" />
                    <Button Grid.Column="2" Classes="rc" Content="修改目录" Margin="0,0,8,0"
                            Command="{Binding EditGlobalDirectoryCommand}" />
                    <Button Grid.Column="3" Classes="rc" Content="打开目录" Margin="0,0,8,0"
                            Command="{Binding OpenGlobalDirectoryCommand}" />
                    <Button Grid.Column="4" Classes="rc" Content="刷新"
                            Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <Border Background="#11151D" BorderBrush="#262B36" BorderThickness="1"
                    CornerRadius="6" Padding="12,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="正在刷新…" FontSize="11"
                               Foreground="#FBBF24" IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#A9B4C6"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- 主体：左录制目标 / 右历史录像 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,14,1.15*" Margin="0,12,0,0">
            <Border Grid.Column="0" Background="#151923" BorderBrush="#262B36"
                    BorderThickness="1" CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <Border Padding="14,11" BorderBrush="#262B36" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TargetSummary}"
                                       FontSize="11" Foreground="#7C8596" VerticalAlignment="Center" />
                            <TextBlock Text="录制目标" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#E6E8EE" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" Padding="12">
                        <Panel>
                            <ItemsControl ItemsSource="{Binding Targets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:RecordingTargetItemViewModel">
                                        <Border Background="#11151D" BorderBrush="#262B36"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="14" Margin="0,0,0,10">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                                <!-- 直播间标题行 -->
                                                <DockPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                VerticalAlignment="Center">
                                                        <Border Background="{Binding PlatformBadgeBackground, Converter={StaticResource Brush}}"
                                                                CornerRadius="4" Padding="6,2"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PlatformBadge}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{Binding PlatformBadgeForeground, Converter={StaticResource Brush}}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayTitle}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#E6E8EE" VerticalAlignment="Center" />
                                                        <Border Background="{Binding StatusBrush, Converter={StaticResource Brush}}"
                                                                CornerRadius="8" Padding="7,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                       Foreground="#10131A" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                IsVisible="{Binding SupportsAutoRecord}">
                                                        <TextBlock Text="自动录制" FontSize="11"
                                                                   Foreground="#A9B4C6" VerticalAlignment="Center" />
                                                        <ToggleSwitch IsChecked="{Binding AutoRecordEnabled, Mode=TwoWay}"
                                                                      OnContent="" OffContent=""
                                                                      VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- 房间号 + 保存目录 -->
                                                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                Spacing="6">
                                                        <Button Classes="rc-xs" Content="修改目录"
                                                                Command="{Binding ChooseDirectoryCommand}" />
                                                        <Button Classes="rc-xs" Content="清除"
                                                                IsVisible="{Binding HasCustomDirectory}"
                                                                Command="{Binding ClearDirectoryCommand}" />
                                                        <Button Classes="rc-xs" Content="打开"
                                                                Command="{Binding OpenDirectoryCommand}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="10"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RoomMeta}" FontSize="11"
                                                                   Foreground="#7C8596" />
                                                        <TextBlock Text="{Binding DirectoryText}" FontSize="11"
                                                                   Foreground="#A9B4C6" MaxWidth="240"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding DirectoryTip}" />
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- 实时指标 -->
                                                <Grid Grid.Row="2" Margin="0,10,0,0"
                                                      ColumnDefinitions="*,*,*,*,*">
                                                    <StackPanel Grid.Column="0" Spacing="1">
                                                        <TextBlock Text="时长" FontSize="10" Foreground="#6B7484" />
                                                        <TextBlock Text="{Binding DurationText}" FontSize="12"
                                                                   Foreground="#E6E8EE" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock Text="码率" FontSize="10" Foreground="#6B7484" />
                                                        <TextBlock Text="{Binding BitrateText}" FontSize="12"
                                                                   Foreground="#E6E8EE" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="1">
                                                        <TextBlock Text="大小" FontSize="10" Foreground="#6B7484" />
                                                        <TextBlock Text="{Binding FileSizeText}" FontSize="12"
                                                                   Foreground="#E6E8EE" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Spacing="1">
                                                        <TextBlock Text="弹幕" FontSize="10" Foreground="#6B7484" />
                                                        <TextBlock Text="{Binding DanmakuCountText}" FontSize="12"
                                                                   Foreground="#E6E8EE" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" Spacing="1">
                                                        <TextBlock Text="高能" FontSize="10" Foreground="#6B7484" />
                                                        <TextBlock Text="{Binding HighlightCountText}" FontSize="12"
                                                                   Foreground="#E6E8EE" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 开录 / 停止 -->
                                                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                                                    <Button Content="{Binding StartStopText}"
                                                            Command="{Binding ToggleRecordingCommand}"
                                                            Background="{Binding StartStopBackground, Converter={StaticResource Brush}}"
                                                            Foreground="{Binding StartStopForeground, Converter={StaticResource Brush}}"
                                                            BorderThickness="0" CornerRadius="6"
                                                            Padding="12,5" FontSize="11" />
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="还没有直播间，请先在监控工作区的左侧主库添加直播间。"
                                       IsVisible="{Binding IsTargetsEmpty}"
                                       Foreground="#6B7484" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center" />
                        </Panel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#151923" BorderBrush="#262B36"
                    BorderThickness="1" CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <Border Padding="14,11" BorderBrush="#262B36" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding HistorySummary}"
                                       FontSize="11" Foreground="#7C8596" VerticalAlignment="Center" />
                            <TextBlock Text="历史录像" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#E6E8EE" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" Padding="12">
                        <Panel>
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:RecordingHistoryItemViewModel">
                                        <Border Background="#11151D" BorderBrush="#262B36"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="12" Margin="0,0,0,8">
                                            <Grid RowDefinitions="Auto,Auto">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <Button Classes="rc-xs" Content="✂ 去剪辑"
                                                                IsEnabled="{Binding CanClip}"
                                                                ToolTip.Tip="{Binding ClipTip}"
                                                                Command="{Binding ClipCommand}" />
                                                        <Button Classes="rc-xs" Content="打开文件夹"
                                                                Command="{Binding OpenFolderCommand}" />
                                                        <Button Classes="rc-xs" Content="删除记录"
                                                                Foreground="#F87171"
                                                                IsEnabled="{Binding CanDelete}"
                                                                ToolTip.Tip="{Binding DeleteTip}"
                                                                Command="{Binding DeleteCommand}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                                VerticalAlignment="Center">
                                                        <Border Background="{Binding PlatformBadgeBackground, Converter={StaticResource Brush}}"
                                                                CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding PlatformBadge}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{Binding PlatformBadgeForeground, Converter={StaticResource Brush}}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding RoomTitle}" FontSize="12"
                                                                   FontWeight="SemiBold" Foreground="#E6E8EE"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{Binding StatusBrush, Converter={StaticResource Brush}}"
                                                                CornerRadius="8" Padding="7,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                       Foreground="#10131A" />
                                                        </Border>
                                                        <TextBlock Text="{Binding StartedAtText}" FontSize="11"
                                                                   Foreground="#7C8596" VerticalAlignment="Center" />
                                                        <TextBlock Text="⚠" FontSize="11" Foreground="#F87171"
                                                                   IsVisible="{Binding HasError}"
                                                                   ToolTip.Tip="{Binding ErrorMessage}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="11"
                                                           Foreground="#A9B4C6" Margin="0,6,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding VideoFileName}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="还没有录像记录。开始录制后，录像与弹幕会出现在这里。"
                                       IsVisible="{Binding IsHistoryEmpty}"
                                       Foreground="#6B7484" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center" />
                        </Panel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="2" Margin="2,10,2,0" FontSize="11" Foreground="#6B7484"
                   Text="提示：删除记录会同时删除对应的 .mkv 视频与 .jsonl 弹幕文件；正在录制的会话需先停止录制。" />
    </Grid>
</UserControl>
