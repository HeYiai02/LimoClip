<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LiveMonitor.Desktop.Views"
             xmlns:vm="using:LiveMonitor.Desktop.ViewModels"
             x:Class="LiveMonitor.Desktop.Views.RecordingCenterView"
             Background="{DynamicResource BrushBgCanvas}">

    <UserControl.Resources>
        <local:StringToBrushConverter x:Key="Brush" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 面板卡片：深色导播台分层 -->
        <Style Selector="Border.rc-panel">
            <Setter Property="Background" Value="{DynamicResource BrushBgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
        </Style>

        <!-- 内容行卡片：比面板再低一层，hover 只抬描边不抬底色 -->
        <Style Selector="Border.rc-card">
            <Setter Property="Background" Value="{DynamicResource BrushBgBase}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.rc-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
        </Style>

        <!-- 顶部概览指标卡 -->
        <Style Selector="Border.rc-metric">
            <Setter Property="Background" Value="{DynamicResource BrushBgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.rc-metric:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
        </Style>

        <Style Selector="TextBlock.rc-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
        </Style>
        <Style Selector="TextBlock.rc-value">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style Selector="TextBlock.rc-caption">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
        </Style>

        <!-- 录制中状态点：只在该元素上做 Opacity 呼吸（0.35 → 1 → 0.35，1.6s 无限循环） -->
        <Style Selector="Ellipse.rc-rec-dot">
            <Setter Property="Fill" Value="{DynamicResource BrushDanger}" />
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 危险操作：幽灵结构 + BrushDanger 前景 -->
        <Style Selector="Button.rc-danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="Button.rc-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
        </Style>
        <Style Selector="Button.rc-danger:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.primary-btn:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.ghost-btn:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="18,16,18,14">
        <!-- ==================== 顶部：标题 + 概览指标卡 + 状态行 ==================== -->
        <StackPanel Grid.Row="0" Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="录制中心" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="统一管理各直播间的录制与历史录像；录制在后台进行，切换视图不会中断。"
                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="正在刷新…" FontSize="11" IsVisible="{Binding IsBusy}"
                               Foreground="{DynamicResource BrushWarning}" VerticalAlignment="Center" />
                    <Button Classes="ghost-btn" Content="刷新" Command="{Binding RefreshCommand}"
                            Padding="8,4" ToolTip.Tip="重新读取录制目标与历史录像" />
                </StackPanel>
            </Grid>

            <!-- 概览指标卡：数据全部来自现有绑定 -->
            <Grid ColumnDefinitions="1.35*,12,*,12,*">
                <!-- 1. 全局录像目录 + 目录操作 -->
                <Border Grid.Column="0" Classes="rc-metric">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                                <Button Classes="ghost-btn" Content="修改目录" Padding="6,3" FontSize="11"
                                        Command="{Binding EditGlobalDirectoryCommand}"
                                        ToolTip.Tip="更改全局录像保存目录（新开始的录制生效）" />
                                <Button Classes="ghost-btn" Content="打开目录" Padding="6,3" FontSize="11"
                                        Command="{Binding OpenGlobalDirectoryCommand}"
                                        ToolTip.Tip="在资源管理器中打开全局录像目录" />
                            </StackPanel>
                            <TextBlock Classes="rc-label" Text="全局录像目录" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding GlobalDirectory}" Classes="mono" FontSize="12"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding GlobalDirectory}" />
                    </StackPanel>
                </Border>

                <!-- 2. 录制目标概览 -->
                <Border Grid.Column="2" Classes="rc-metric">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="rc-label" Text="录制目标" />
                        <TextBlock Classes="mono rc-value" Text="{Binding TargetSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="rc-caption" Text="按直播间独立开录，切换视图不中断"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 3. 历史录像概览 -->
                <Border Grid.Column="4" Classes="rc-metric">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="rc-label" Text="历史录像" />
                        <TextBlock Classes="mono rc-value" Text="{Binding HistorySummary}" />
                        <TextBlock Classes="rc-caption" Text="完成录制后可直接进入剪辑台"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 状态行：替代旧的全宽描边状态条 -->
            <Grid ColumnDefinitions="Auto,*">
                <Border Width="2" Height="12" CornerRadius="1" VerticalAlignment="Center"
                        Background="{DynamicResource BrushBorderStrong}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
            </Grid>
        </StackPanel>

        <!-- ==================== 主体：左录制目标 / 右历史录像 ==================== -->
        <Grid Grid.Row="1" ColumnDefinitions="*,14,1.15*" Margin="0,12,0,0">
            <!-- 左：录制目标 -->
            <Border Grid.Column="0" Classes="rc-panel">
                <Grid RowDefinitions="Auto,*">
                    <Border Padding="14,10" BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TargetSummary}"
                                       FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{DynamicResource IconRecord}" Width="12" Height="12"
                                          Foreground="{DynamicResource BrushDanger}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="录制目标" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" Padding="12">
                        <Panel>
                            <ItemsControl ItemsSource="{Binding Targets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:RecordingTargetItemViewModel">
                                        <Border Classes="rc-card" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <!-- 录制中：左侧 3px 红色竖条 -->
                                                <Border Grid.Column="0" Width="3" CornerRadius="2"
                                                        Background="{DynamicResource BrushDanger}"
                                                        IsVisible="{Binding IsRecording}"
                                                        Margin="0,2,12,2" />

                                                <Grid Grid.Column="1"
                                                      RowDefinitions="Auto,Auto,Auto,Auto">
                                                    <!-- 标题行：状态点 / 平台徽章 / 标题 / 状态胶囊 / 自动录制 -->
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right"
                                                                    Orientation="Horizontal" Spacing="6"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding SupportsAutoRecord}">
                                                            <TextBlock Text="自动录制" FontSize="11"
                                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                                       VerticalAlignment="Center" />
                                                            <ToggleSwitch IsChecked="{Binding AutoRecordEnabled, Mode=TwoWay}"
                                                                          OnContent="" OffContent=""
                                                                          VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <WrapPanel Orientation="Horizontal"
                                                                   VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Classes="rc-rec-dot"
                                                                     IsVisible="{Binding IsRecording}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,7,0" />
                                                            <Border Background="{Binding PlatformBadgeBackground, Converter={StaticResource Brush}}"
                                                                    CornerRadius="4" Padding="5,2"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding PlatformBadge}"
                                                                           FontSize="9.5" FontWeight="SemiBold"
                                                                           Foreground="{Binding PlatformBadgeForeground, Converter={StaticResource Brush}}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0" />
                                                            <!-- 直播中徽章：配合「录制中优先、直播中其次」的排序，未录制时展示 -->
                                                            <Border Background="#123DDC97"
                                                                    CornerRadius="{DynamicResource RadiusPill}"
                                                                    Padding="6,1" Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding ShowLiveBadge}">
                                                                <TextBlock Text="直播中"
                                                                           FontSize="9.5" FontWeight="SemiBold"
                                                                           Foreground="#3DDC97" />
                                                            </Border>
                                                            <!-- 状态胶囊：StatusBrush 文字 + 同色 16% 低饱和底 -->
                                                            <Grid VerticalAlignment="Center">
                                                                <Border Background="{Binding StatusBrush, Converter={StaticResource Brush}}"
                                                                        CornerRadius="{DynamicResource RadiusPill}"
                                                                        Opacity="0.16" />
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           FontSize="10" FontWeight="Medium"
                                                                           Foreground="{Binding StatusBrush, Converter={StaticResource Brush}}"
                                                                           Margin="8,2" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </WrapPanel>
                                                    </DockPanel>

                                                    <!-- 房间号 + 保存目录 + 行内目录操作 -->
                                                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                                        <StackPanel DockPanel.Dock="Right"
                                                                    Orientation="Horizontal" Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <Button Classes="ghost-btn" Content="修改目录"
                                                                    Padding="6,3" FontSize="11"
                                                                    Command="{Binding ChooseDirectoryCommand}"
                                                                    ToolTip.Tip="为该直播间设置独立保存目录" />
                                                            <Button Classes="rc-danger" Content="清除"
                                                                    Padding="6,3" FontSize="11"
                                                                    IsVisible="{Binding HasCustomDirectory}"
                                                                    Command="{Binding ClearDirectoryCommand}"
                                                                    ToolTip.Tip="清除独立目录，改为跟随全局目录" />
                                                            <Button Classes="ghost-btn" Content="打开"
                                                                    Padding="6,3" FontSize="11"
                                                                    Command="{Binding OpenDirectoryCommand}"
                                                                    ToolTip.Tip="在资源管理器中打开该直播间的保存目录" />
                                                        </StackPanel>
                                                        <Grid ColumnDefinitions="Auto,*"
                                                              VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RoomMeta}" FontSize="11"
                                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DirectoryText}"
                                                                       Classes="mono" FontSize="11"
                                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                                       Margin="10,0,12,0"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding DirectoryTip}" />
                                                        </Grid>
                                                    </DockPanel>

                                                    <!-- 实时指标：等宽数字 -->
                                                    <Border Grid.Row="2" Margin="0,10,0,0"
                                                            Padding="0,10,0,0"
                                                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                            BorderThickness="0,1,0,0">
                                                        <Grid ColumnDefinitions="*,*,*,*,*">
                                                            <StackPanel Grid.Column="0" Spacing="1">
                                                                <TextBlock Classes="rc-caption" Text="时长" />
                                                                <TextBlock Classes="mono"
                                                                           Text="{Binding DurationText}"
                                                                           FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="1">
                                                                <TextBlock Classes="rc-caption" Text="码率" />
                                                                <TextBlock Classes="mono"
                                                                           Text="{Binding BitrateText}"
                                                                           FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="1">
                                                                <TextBlock Classes="rc-caption" Text="大小" />
                                                                <TextBlock Classes="mono"
                                                                           Text="{Binding FileSizeText}"
                                                                           FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="3" Spacing="1">
                                                                <TextBlock Classes="rc-caption" Text="弹幕" />
                                                                <TextBlock Classes="mono"
                                                                           Text="{Binding DanmakuCountText}"
                                                                           FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4" Spacing="1">
                                                                <TextBlock Classes="rc-caption" Text="高能" />
                                                                <TextBlock Classes="mono"
                                                                           Text="{Binding HighlightCountText}"
                                                                           FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- 开录 / 停止：主操作按钮；录制中额外提供「边录边剪」入口 -->
                                                    <StackPanel Grid.Row="3" Margin="0,10,0,0"
                                                                Orientation="Horizontal" Spacing="6"
                                                                HorizontalAlignment="Right">
                                                        <Button Classes="primary-btn"
                                                                Content="{Binding StartStopText}"
                                                                Command="{Binding ToggleRecordingCommand}"
                                                                Background="{Binding StartStopBackground, Converter={StaticResource Brush}}"
                                                                Foreground="{Binding StartStopForeground, Converter={StaticResource Brush}}"
                                                                Padding="16,6" FontSize="12"
                                                                ToolTip.Tip="开始或停止该直播间的录制" />
                                                        <Button Classes="ghost-btn" Content="✂ 边录边剪"
                                                                IsVisible="{Binding IsRecording}"
                                                                Command="{Binding LiveClipCommand}"
                                                                Padding="10,6" FontSize="12"
                                                                ToolTip.Tip="边录边剪：对正在录制的分片进行实时剪辑" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel IsVisible="{Binding IsTargetsEmpty}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="8" Margin="20">
                                <Border Width="36" Height="36"
                                        CornerRadius="{DynamicResource RadiusCard}"
                                        Background="{DynamicResource BrushBgElevated}"
                                        HorizontalAlignment="Center">
                                    <PathIcon Data="{DynamicResource IconRecord}"
                                              Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{DynamicResource BrushTextMuted}" />
                                </Border>
                                <TextBlock Text="还没有直播间，请先在监控工作区的左侧主库添加直播间。"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="300"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Panel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右：历史录像 -->
            <Border Grid.Column="2" Classes="rc-panel">
                <Grid RowDefinitions="Auto,*">
                    <Border Padding="14,10" BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding HistorySummary}"
                                       FontSize="11" Foreground="{DynamicResource BrushTextMuted}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{DynamicResource IconScissors}" Width="12" Height="12"
                                          Foreground="{DynamicResource BrushTextSecondary}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="历史录像" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" Padding="12">
                        <Panel>
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:RecordingHistoryItemViewModel">
                                        <Border Classes="rc-card" Margin="0,0,0,8" Padding="14,12">
                                            <Grid RowDefinitions="Auto,Auto">
                                                <!-- 标题行 + 行内操作 -->
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right"
                                                                Orientation="Horizontal" Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <Button Classes="primary-btn" Content="✂ 边录边剪"
                                                                Padding="10,4" FontSize="11"
                                                                IsVisible="{Binding IsLive}"
                                                                ToolTip.Tip="{Binding LiveClipTip}"
                                                                Command="{Binding LiveClipCommand}" />
                                                        <Button Classes="primary-btn" Content="去剪辑"
                                                                Padding="10,4" FontSize="11"
                                                                IsVisible="{Binding CanShowClip}"
                                                                IsEnabled="{Binding CanClip}"
                                                                ToolTip.Tip="{Binding ClipTip}"
                                                                Command="{Binding ClipCommand}" />
                                                        <Button Classes="ghost-btn" Content="重试合并"
                                                                Padding="6,3" FontSize="11"
                                                                IsVisible="{Binding CanRetryMerge}"
                                                                ToolTip.Tip="{Binding RetryMergeTip}"
                                                                Command="{Binding RetryMergeCommand}" />
                                                        <Button Classes="ghost-btn" Content="打开文件夹"
                                                                Padding="6,3" FontSize="11"
                                                                Command="{Binding OpenFolderCommand}"
                                                                ToolTip.Tip="在资源管理器中打开该录像所在文件夹" />
                                                        <Button Classes="rc-danger" Content="删除记录"
                                                                Padding="6,3" FontSize="11"
                                                                IsEnabled="{Binding CanDelete}"
                                                                ToolTip.Tip="{Binding DeleteTip}"
                                                                Command="{Binding DeleteCommand}" />
                                                    </StackPanel>
                                                    <WrapPanel Orientation="Horizontal"
                                                               VerticalAlignment="Center">
                                                        <Border Background="{Binding PlatformBadgeBackground, Converter={StaticResource Brush}}"
                                                                CornerRadius="4" Padding="5,2"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding PlatformBadge}"
                                                                       FontSize="9.5" FontWeight="SemiBold"
                                                                       Foreground="{Binding PlatformBadgeForeground, Converter={StaticResource Brush}}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding RoomTitle}"
                                                                   FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0" />
                                                        <!-- 状态胶囊：保持状态语义色（完成绿 / 录制红 / 失败红 / 待处理琥珀） -->
                                                        <Grid VerticalAlignment="Center">
                                                            <Border Background="{Binding StatusBrush, Converter={StaticResource Brush}}"
                                                                    CornerRadius="{DynamicResource RadiusPill}"
                                                                    Opacity="0.16" />
                                                            <TextBlock Text="{Binding StatusText}"
                                                                       FontSize="10" FontWeight="Medium"
                                                                       Foreground="{Binding StatusBrush, Converter={StaticResource Brush}}"
                                                                       Margin="8,2" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="⚠" FontSize="11"
                                                                   Foreground="{DynamicResource BrushDanger}"
                                                                   IsVisible="{Binding HasError}"
                                                                   ToolTip.Tip="{Binding ErrorMessage}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0" />
                                                    </WrapPanel>
                                                </DockPanel>

                                                <!-- 时间 + 摘要 -->
                                                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*"
                                                      Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding StartedAtText}"
                                                               Classes="mono" FontSize="10.5"
                                                               Foreground="{DynamicResource BrushTextMuted}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="·" FontSize="10"
                                                               Foreground="{DynamicResource BrushTextMuted}"
                                                               Margin="6,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource BrushTextSecondary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding VideoFileName}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel IsVisible="{Binding IsHistoryEmpty}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="8" Margin="20">
                                <Border Width="36" Height="36"
                                        CornerRadius="{DynamicResource RadiusCard}"
                                        Background="{DynamicResource BrushBgElevated}"
                                        HorizontalAlignment="Center">
                                    <PathIcon Data="{DynamicResource IconScissors}"
                                              Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{DynamicResource BrushTextMuted}" />
                                </Border>
                                <TextBlock Text="还没有录像记录。开始录制后，录像与弹幕会出现在这里。"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="300"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Panel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 底部提示 ==================== -->
        <TextBlock Grid.Row="2" Margin="2,10,2,0" FontSize="11"
                   Foreground="{DynamicResource BrushTextMuted}"
                   Text="提示：删除记录会同时删除对应的 .mkv 视频与 .jsonl 弹幕文件；正在录制的会话需先停止录制。" />
    </Grid>
</UserControl>
