<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveMonitor.Desktop.Views.ConfirmDeleteWindow"
        Title="从主库删除"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgBase}">
  <StackPanel>
    <!-- 标题区 -->
    <StackPanel Margin="20,18,20,10" Spacing="6">
      <TextBlock Text="删除直播间"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushTextPrimary}" />
      <TextBlock x:Name="MessageText"
                 FontSize="12" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSecondary}" />
    </StackPanel>

    <!-- 影响说明 -->
    <Border Classes="card" Margin="20,0,20,10" Padding="16,14">
      <StackPanel Spacing="6">
        <TextBlock Text="工作区中的对应窗格也会被清空，此操作不可撤销。"
                   FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushDanger}" />
        <TextBlock Text="已录制的录像与弹幕文件不受影响，可在录制中心继续管理。"
                   FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushTextMuted}" />
      </StackPanel>
    </Border>

    <!-- 操作栏 -->
    <Border BorderBrush="{DynamicResource BrushBorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="取消" Classes="subtle-btn" Click="OnCancel" />
        <Button Content="删除" Classes="danger-btn" Click="OnDelete" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
