<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveMonitor.Desktop.Views.AddRoomWindow"
        Icon="avares://LimoClip/Assets/AppIcon.ico"
        Title="添加直播间"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgBase}">
  <StackPanel>
    <!-- 标题区 -->
    <StackPanel Margin="20,18,20,10" Spacing="4">
      <TextBlock Text="添加直播间"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushTextPrimary}" />
      <TextBlock Text="粘贴平台直播间链接，或直接粘贴清流直链"
                 FontSize="11.5"
                 Foreground="{DynamicResource BrushTextSecondary}" />
    </StackPanel>

    <!-- 直播地址 -->
    <Border Classes="card" Margin="20,0,20,10" Padding="16,14">
      <StackPanel Spacing="10">
        <TextBlock Text="直播地址" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextSecondary}" />
        <TextBox x:Name="UrlBox"
                 FontSize="12"
                 Watermark="例如 https://live.bilibili.com/7734200，或粘贴清流直链" />
        <CheckBox x:Name="CustomStreamCheck"
                  FontSize="11"
                  Foreground="{DynamicResource BrushTextSecondary}"
                  Content="作为自定义清流添加（直链 / HLS / FLV / RTMP / RTSP / SRT，无弹幕）"
                  ToolTip.Tip="勾选后跳过平台识别，直接按清流直链播放与录制；无后缀的 CDN Token 链接也请勾选。" />
        <StackPanel x:Name="CustomHeadersPanel" IsVisible="False" Spacing="8">
          <TextBlock Text="防盗链请求头（可选，仅 http/https 生效）"
                     FontSize="11"
                     Foreground="{DynamicResource BrushTextMuted}" />
          <TextBox x:Name="RefererBox" FontSize="11"
                   Watermark="Referer，例如 https://live.example.com/" />
          <TextBox x:Name="UserAgentBox" FontSize="11"
                   Watermark="User-Agent（留空使用内置浏览器 UA）" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 分组 -->
    <Border Classes="card" Margin="20,0,20,10" Padding="16,14">
      <StackPanel Spacing="10">
        <TextBlock Text="分组" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextSecondary}" />
        <TextBox x:Name="GroupBox"
                 FontSize="12"
                 Watermark="可选，例如 游戏 / VTB / 赛事" />
      </StackPanel>
    </Border>

    <!-- 错误提示 -->
    <TextBlock x:Name="ErrorText"
               Margin="20,0,20,6"
               FontSize="11"
               TextWrapping="Wrap"
               Foreground="{DynamicResource BrushDanger}" />

    <!-- 操作栏 -->
    <Border BorderBrush="{DynamicResource BrushBorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="支持 B站 / Twitch / YouTube / 虎牙 / 斗鱼 / 抖音"
                   FontSize="10.5"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource BrushTextMuted}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="取消" Classes="subtle-btn" Click="OnCancel" />
          <Button x:Name="AddButton" Content="添加" Classes="primary-btn" Click="OnAdd" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</Window>
