<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveMonitor.Desktop.Views.AddRoomWindow"
        Title="添加直播间"
        Width="480" Height="270"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F1115">
  <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <TextBlock Grid.Row="0" Text="粘贴 B站 / Twitch / YouTube 直播间链接" FontSize="13"
               Foreground="#E6E8EE" Margin="0,0,0,10" />
    <TextBox Grid.Row="1" x:Name="UrlBox" Watermark="例如 https://live.bilibili.com/7734200、twitch.tv/eslcs 或 youtube.com/watch?v=..."
             FontSize="12" />
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,10,0,0">
      <TextBlock Text="分组" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
      <TextBox Grid.Column="1" x:Name="GroupBox" Height="28" HorizontalAlignment="Stretch"
               Watermark="可选，例如 游戏 / VTB / 赛事" />
    </Grid>
    <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="#F87171" FontSize="11"
               TextWrapping="Wrap" Margin="0,8,0,0" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="取消" Click="OnCancel" />
      <Button x:Name="AddButton" Content="添加" Click="OnAdd" Classes="accent" />
    </StackPanel>
  </Grid>
</Window>
