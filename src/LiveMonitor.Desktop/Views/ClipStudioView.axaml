<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiveMonitor.Desktop.ViewModels"
             xmlns:player="using:LiveMonitor.Desktop.Player"
             xmlns:controls="using:LiveMonitor.Desktop.Controls"
             x:Class="LiveMonitor.Desktop.Views.ClipStudioView"
             Background="#0F1115">
    <UserControl.Styles>
        <Style Selector="TextBlock.clip-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E5E7EB" />
        </Style>
        <Style Selector="TextBlock.clip-section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="TextBlock.clip-caption">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#64748B" />
        </Style>
        <Style Selector="TextBlock.clip-value">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>
        <Style Selector="Button.clip-action">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.clip-primary">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.clip-icon">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="54" />
        </Style>
        <Style Selector="Button.clip-xs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="Button.clip-highlight">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.clip-highlight:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E293B" />
        </Style>
        <Style Selector="TextBox.clip-field">
            <Setter Property="Background" Value="#0B0E13" />
            <Setter Property="BorderBrush" Value="#262B36" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ComboBox.clip-field">
            <Setter Property="Background" Value="#0B0E13" />
            <Setter Property="BorderBrush" Value="#262B36" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="RadioButton.clip-mode">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="CheckBox.clip-check">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="14" RowDefinitions="*,180" ColumnDefinitions="260,*,280">
        <!-- 左：场次与高能导航 -->
        <Border Grid.Row="0" Grid.Column="0" Background="#11151D" BorderBrush="#262B36"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,10">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                <TextBlock Classes="clip-title" Text="✂ 剪辑台" />
                <TextBlock Grid.Row="1" Classes="clip-section" Text="切换录像场次" />
                <ComboBox Grid.Row="2" Classes="clip-field" Margin="0,4,0,0"
                          ItemsSource="{Binding Sessions}"
                          SelectedItem="{Binding SelectedSession}"
                          PlaceholderText="选择录制场次…">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="#E5E7EB" />
                                <TextBlock Text="{Binding DetailText}" FontSize="10" Foreground="#94A3B8"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="3" Classes="clip-action" Margin="0,6,0,0"
                        Content="📂 打开本地文件…"
                        Command="{Binding OpenLocalFileCommand}" />
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <TextBlock Classes="clip-caption" Text="{Binding DanmakuInfoText}" />
                </StackPanel>
                <TextBlock Grid.Row="5" Classes="clip-section" Text="── 高能推荐 ──" Margin="0,10,0,2" />
                <ScrollViewer Grid.Row="5" Margin="0,28,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Highlights}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 卡片根节点改为 StackPanel：上层「跳转」与下层「🎙 转写」是两个并列 Button，避免嵌套 Button 冒泡冲突。 -->
                                <StackPanel Margin="0,0,0,4">
                                    <Button Classes="clip-highlight" Click="OnHighlightClick">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="🔥" FontSize="11" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#E5E7EB" />
                                                <TextBlock Text="{Binding RateText}" FontSize="9" Foreground="#F87171" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="推荐区间" FontSize="9"
                                                       Foreground="#64748B" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Grid ColumnDefinitions="Auto,*" Margin="6,2,4,0">
                                        <Button Classes="clip-xs" Content="{Binding TranscribeButtonText}"
                                                IsEnabled="{Binding CanTranscribe}"
                                                Click="OnTranscribeHighlightClick"
                                                ToolTip.Tip="识别该高能片段（前后约 10/20 秒）的语音" />
                                        <Button Grid.Column="1" Classes="clip-highlight" Margin="6,0,0,0"
                                                Padding="4,2" IsVisible="{Binding HasAsrResult}"
                                                Click="OnHighlightAsrSummaryClick"
                                                ToolTip.Tip="{Binding AsrSummaryToolTip}">
                                            <TextBlock Text="{Binding AsrSummary}" FontSize="9"
                                                       Foreground="#A5B4FC" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding AsrError}" FontSize="9" Foreground="#F87171"
                                               TextWrapping="Wrap" IsVisible="{Binding HasAsrError}"
                                               Margin="6,2,4,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 中：本地预览播放器 -->
        <Border Grid.Row="0" Grid.Column="1" Background="#11151D" BorderBrush="#262B36"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,10">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="1">
                    <TextBlock Text="{Binding VideoTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#E5E7EB" />
                    <TextBlock Text="{Binding VideoSubtitle}" FontSize="10" Foreground="#94A3B8"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Row="1" Margin="0,8,0,0" Background="#05070A" CornerRadius="8"
                        BorderBrush="#1E293B" BorderThickness="1" ClipToBounds="True">
                    <player:LocalClipPlayerView x:Name="Player" />
                </Border>
                <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                    <Button Classes="clip-icon" Content="◀ -5s" Click="OnSeekBackClick" />
                    <Button Grid.Column="1" Classes="clip-icon" Margin="6,0,0,0"
                            Content="{Binding PlayPauseGlyph}" Click="OnPlayPauseClick" FontSize="14" />
                    <Button Grid.Column="2" Classes="clip-icon" Margin="6,0,0,0"
                            Content="+5s ▶" Click="OnSeekForwardClick" />
                    <TextBlock Grid.Column="3" Text="{Binding PositionText}" FontSize="12"
                               Foreground="#CBD5E1" VerticalAlignment="Center" Margin="12,0" />
                    <ComboBox Grid.Column="4" Classes="clip-field" Width="92" VerticalAlignment="Center"
                              ItemsSource="{Binding SpeedOptions}"
                              SelectedItem="{Binding SelectedSpeedOption}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" FontSize="11" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Grid.Column="5" Classes="clip-check" Margin="10,0,0,0"
                              Content="💬 弹幕回放" IsChecked="{Binding DanmakuPlaybackEnabled}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 右：切片导出面板 -->
        <Border Grid.Row="0" Grid.Column="2" Background="#11151D" BorderBrush="#262B36"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6">
                    <TextBlock Classes="clip-title" Text="切片导出面板" />
                    <TextBlock Classes="clip-section" Text="当前区间" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel>
                            <TextBlock Classes="clip-caption" Text="入点" />
                            <TextBlock Classes="clip-value" Text="{Binding InText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="clip-caption" Text="出点" />
                            <TextBlock Classes="clip-value" Text="{Binding OutText}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="clip-xs" Content="设入点 (I)" Click="OnSetInClick" />
                        <Button Classes="clip-xs" Content="设出点 (O)" Click="OnSetOutClick" />
                        <TextBlock Classes="clip-caption" VerticalAlignment="Center"
                                   Text="选区时长" />
                        <TextBlock Classes="clip-caption" VerticalAlignment="Center" Foreground="#E5E7EB"
                                   Text="{Binding SelectionText}" />
                    </StackPanel>
                    <TextBlock Classes="clip-section" Text="导出模式" />
                    <RadioButton Classes="clip-mode" GroupName="clipMode" Content="仅无弹幕（秒切）"
                                 IsChecked="{Binding IsCleanOnlyExport}" />
                    <RadioButton Classes="clip-mode" GroupName="clipMode" Content="仅有弹幕（硬编烧录）"
                                 IsChecked="{Binding IsDanmakuOnlyExport}" />
                    <RadioButton Classes="clip-mode" GroupName="clipMode" Content="同时导出两版"
                                 IsChecked="{Binding IsBothExport}" />
                    <TextBlock Classes="clip-section" Text="编码器" />
                    <TextBlock Text="{Binding EncoderText}" FontSize="11" Foreground="#A5B4FC" />
                    <TextBlock Classes="clip-section" Text="输出目录" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Classes="clip-field" Text="{Binding OutputDirectory}" />
                        <Button Grid.Column="1" Classes="clip-xs" Margin="6,0,0,0" Content="浏览…"
                                Command="{Binding PickOutputDirectoryAsyncCommand}" />
                    </Grid>
                    <TextBlock Classes="clip-section" Text="文件名（不含扩展名）" />
                    <TextBox Classes="clip-field" Text="{Binding OutputFileName}" />
                    <TextBlock Classes="clip-caption" Text="{Binding KeyframeTip}" TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <Button Classes="clip-primary" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                            Content="{Binding ExportButtonText}"
                            Command="{Binding ExportCommand}"
                            IsEnabled="{Binding CanExport}" />
                    <Button Classes="clip-xs" Margin="0,2,0,0" HorizontalAlignment="Stretch"
                            Content="取消当前导出"
                            Command="{Binding CancelExportCommand}"
                            IsVisible="{Binding IsExporting}" />
                    <TextBlock Classes="clip-section" Text="导出进度" />
                    <ItemsControl ItemsSource="{Binding ExportTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0B0E13" BorderBrush="#262B36" BorderThickness="1"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#E5E7EB"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding ModeText}" FontSize="9"
                                                       Foreground="#94A3B8" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                                                     Height="4" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding StateText}" FontSize="10"
                                                       Foreground="#A5B4FC" />
                                            <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="10"
                                                       Foreground="#94A3B8" />
                                        </Grid>
                                        <TextBlock Text="{Binding OutputText}" FontSize="9" Foreground="#4ADE80"
                                                   TextWrapping="Wrap" IsVisible="{Binding HasOutput}" />
                                        <TextBlock Text="{Binding RangeText}" FontSize="9" Foreground="#64748B" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#94A3B8"
                               TextWrapping="Wrap" Margin="0,6,0,4" />

                    <!-- V0.5-A 语音识别：识别当前时间轴选区，展示分段结果并可点击单句跳转。 -->
                    <Border Background="#0B0E13" BorderBrush="#262B36" BorderThickness="1"
                            CornerRadius="6" Padding="8" Margin="0,6,0,0"
                            IsVisible="{Binding IsAsrPanelVisible}">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="clip-title" Text="🎙 语音识别" />
                            <Button Classes="clip-primary" HorizontalAlignment="Stretch"
                                    Content="🎙 识别当前选区"
                                    Command="{Binding TranscribeSelectionCommand}" />
                            <Button Classes="clip-xs" HorizontalAlignment="Stretch"
                                    Content="取消识别"
                                    Command="{Binding CancelAsrCommand}"
                                    IsVisible="{Binding IsAsrRunning}" />
                            <ProgressBar IsIndeterminate="True" Height="3"
                                         IsVisible="{Binding IsAsrRunning}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding AsrStatusText}" FontSize="11"
                                           Foreground="#A5B4FC" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding AsrRangeText}" FontSize="9"
                                           Foreground="#64748B" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding AsrErrorText}" FontSize="10" Foreground="#F87171"
                                       TextWrapping="Wrap" IsVisible="{Binding HasAsrError}" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAsrResult}">
                                <TextBlock Text="{Binding AsrProviderLabel}" FontSize="9"
                                           Foreground="#64748B" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="clip-xs" Content="复制文本"
                                        Click="OnCopyAsrTextClick" />
                            </Grid>
                            <TextBlock Text="{Binding AsrFullText}" FontSize="10" Foreground="#94A3B8"
                                       TextWrapping="Wrap" MaxHeight="120"
                                       IsVisible="{Binding HasAsrResult}" />
                            <ItemsControl ItemsSource="{Binding AsrLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="clip-xs" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Margin="0,1,0,0"
                                                Padding="6,4" Click="OnAsrLineClick"
                                                ToolTip.Tip="点击跳转到该句对应的画面">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="{Binding TimeText}" FontSize="9"
                                                           Foreground="#64748B" Margin="0,1,6,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10"
                                                           Foreground="#E5E7EB" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 底：双波形时间轴 -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#11151D"
                BorderBrush="#262B36" BorderThickness="1" CornerRadius="8" Padding="8">
            <controls:ClipTimelineControl x:Name="Timeline" Height="156"
                                          ToolTip.Tip="双波形时间轴：蓝色=音频波形，橙色=弹幕密度，红色竖线=播放头，左/右蓝色竖线=入点/出点，蓝色区域=剪辑选区。点击或拖动上方三角定位播放头；拖动 IN/OUT 手柄调整选区；滚轮缩放，双击复位。" />
        </Border>
    </Grid>
</UserControl>
