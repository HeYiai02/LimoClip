<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LiveMonitor.Desktop.Views.RoomTileView">
  <Grid Background="#0B0E14"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
    <ContentControl Content="{Binding PlayerView}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

    <!-- 空窗格占位 -->
    <Border IsVisible="{Binding IsPlaceholder}"
            Background="#10141C">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <TextBlock Text="空窗格" FontSize="15" FontWeight="SemiBold"
                   Foreground="#596273" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding DetailText}" FontSize="11"
                   Foreground="#4B5361" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- 左上角窗格标识与状态 -->
    <Border Background="#CC0B0E14"
            CornerRadius="4"
            Padding="6,3"
            Margin="6"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsVisible="{Binding HasRoom}">
      <StackPanel Spacing="1">
        <TextBlock Text="{Binding DisplayTitle}" FontSize="10" FontWeight="SemiBold"
                   Foreground="#E6E8EE" />
        <TextBlock Text="{Binding StateText}" FontSize="9" Foreground="#7C8596" />
      </StackPanel>
    </Border>

    <!-- 顶部中央拖动条：拖动到另一个窗格即交换两个房间的位置 -->
    <Border x:Name="DragHandle"
            Width="76" Height="14"
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="Transparent"
            Cursor="SizeAll"
            ToolTip.Tip="拖动到另一个窗格交换位置"
            IsVisible="{Binding HasRoom}"
            PointerPressed="OnDragHandlePressed"
            PointerReleased="OnDragHandleReleased">
      <TextBlock Text="⣿" FontSize="11" Foreground="#7C8596"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <!-- 右上角全屏 / 移出工作区；只从工作区移除，主库记录保留 -->
    <StackPanel Orientation="Horizontal"
                Spacing="4"
                Margin="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsVisible="{Binding HasRoom}">
      <Button x:Name="FocusButton"
              Content="⛶"
              FontSize="12"
              Width="24" Height="24"
              Padding="0"
              Opacity="0.55"
              ToolTip.Tip="全屏（双击窗格）"
              Click="OnFocusClick" />
      <Button x:Name="RemoveButton"
              Content="✕"
              FontSize="11"
              Width="24" Height="24"
              Padding="0"
              Opacity="0.55"
              ToolTip.Tip="移出工作区"
              Click="OnRemoveClick" />
    </StackPanel>
  </Grid>
</UserControl>
