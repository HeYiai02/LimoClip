<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LiveMonitor.Desktop.Views.RoomTileView">
  <Grid Background="{DynamicResource BrushBgBase}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
    <ContentControl Content="{Binding PlayerView}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

    <!-- 空窗格占位 -->
    <Border IsVisible="{Binding IsPlaceholder}"
            Background="{DynamicResource BrushBgSurface}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <TextBlock Text="空窗格" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding DetailText}" FontSize="11"
                   Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- 左上角窗格标识与状态 -->
    <Border Background="#40070A10"
            CornerRadius="4"
            Padding="6,3"
            Margin="6"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsVisible="{Binding HasRoom}">
      <StackPanel Spacing="1">
        <TextBlock Text="{Binding DisplayTitle}" FontSize="10.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextPrimary}" />
        <TextBlock Text="{Binding StateText}" FontSize="9"
                   Foreground="{DynamicResource BrushTextMuted}" />
      </StackPanel>
    </Border>

    <!-- 顶部中央拖动条：拖动到另一个窗格即交换两个房间的位置 -->
    <Border x:Name="DragHandle"
            Width="76" Height="14"
            Margin="0,4,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="Transparent"
            Cursor="SizeAll"
            ToolTip.Tip="拖动到另一个窗格交换位置"
            IsVisible="{Binding HasRoom}"
            PointerPressed="OnDragHandlePressed"
            PointerReleased="OnDragHandleReleased">
      <Border Width="30" Height="3"
              CornerRadius="2"
              Background="#4DFFFFFF"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
    </Border>

    <!-- 右上角全屏 / 移出工作区；只从工作区移除，主库记录保留 -->
    <StackPanel Orientation="Horizontal"
                Spacing="2"
                Margin="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsVisible="{Binding HasRoom}">
      <Button x:Name="FocusButton"
              Classes="ghost-btn"
              Width="26" Height="26"
              Padding="0"
              Opacity="0.8"
              ToolTip.Tip="全屏（双击窗格）"
              Click="OnFocusClick">
        <PathIcon Width="12" Height="12"
                  Data="{DynamicResource IconFullscreen}"
                  Foreground="{DynamicResource BrushTextSecondary}" />
      </Button>
      <Button x:Name="RemoveButton"
              Classes="ghost-btn"
              Width="26" Height="26"
              Padding="0"
              Opacity="0.8"
              ToolTip.Tip="移出工作区"
              Click="OnRemoveClick">
        <PathIcon Width="12" Height="12"
                  Data="{DynamicResource IconClose}"
                  Foreground="{DynamicResource BrushTextSecondary}" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
