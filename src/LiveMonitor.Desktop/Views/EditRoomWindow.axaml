<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveMonitor.Desktop.Views.EditRoomWindow"
        Icon="avares://LiveMonitor.Desktop/Assets/AppIcon.ico"
        Title="修改直播间"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgBase}">
  <StackPanel>
    <!-- 标题区 -->
    <StackPanel Margin="20,18,20,10" Spacing="4">
      <TextBlock Text="修改直播间"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushTextPrimary}" />
      <TextBlock Text="调整显示名称、分组与序号；自定义清流可同时更新拉流地址与请求头。"
                 FontSize="11.5" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextSecondary}" />
    </StackPanel>

    <!-- 基本信息 -->
    <Border Classes="card" Margin="20,0,20,10" Padding="16,14">
      <StackPanel Spacing="10">
        <TextBlock Text="基本信息" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextSecondary}" />
        <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Grid.Row="0" Text="显示名称" FontSize="11"
                     Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
          <TextBox Grid.Row="0" Grid.Column="1" x:Name="AliasBox" FontSize="12" />

          <TextBlock Grid.Row="1" Text="分组" FontSize="11"
                     Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="GroupBox" FontSize="12"
                   Watermark="可选，例如 游戏 / VTB / 赛事" />

          <TextBlock Grid.Row="2" Text="序号" FontSize="11"
                     Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="NumberBox" FontSize="12" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 清流设置（仅自定义清流） -->
    <Border Classes="card" x:Name="CustomStreamPanel" IsVisible="False"
            Margin="20,0,20,10" Padding="16,14">
      <StackPanel Spacing="10">
        <TextBlock Text="清流设置（仅自定义清流）" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextSecondary}" />
        <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Grid.Row="0" Text="拉流地址" FontSize="11"
                     Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
          <TextBox Grid.Row="0" Grid.Column="1" x:Name="StreamUrlBox" FontSize="11"
                   Watermark="http(s) / rtmp / rtsp / srt 直链" />

          <TextBlock Grid.Row="1" Text="Referer" FontSize="11"
                     Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="RefererBox" FontSize="11"
                   Watermark="可选，防盗链 Referer" />

          <TextBlock Grid.Row="2" Text="User-Agent" FontSize="11"
                     Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="UserAgentBox" FontSize="11"
                   Watermark="可选，留空使用内置浏览器 UA" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- 错误提示 -->
    <TextBlock x:Name="ErrorText"
               Margin="20,0,20,6"
               FontSize="11" TextWrapping="Wrap"
               Foreground="{DynamicResource BrushDanger}" />

    <!-- 操作栏 -->
    <Border BorderBrush="{DynamicResource BrushBorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="取消" Classes="subtle-btn" Click="OnCancel" />
        <Button x:Name="SaveButton" Content="保存" Classes="primary-btn" Click="OnSave" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
