<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveMonitor.Desktop.Views.EditRoomWindow"
        Title="修改直播间"
        Width="460" Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F1115">
  <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
    <TextBlock Grid.Row="0" Text="修改直播间信息" FontSize="13"
               Foreground="#E6E8EE" Margin="0,0,0,12" />

    <Grid Grid.Row="1" ColumnDefinitions="72,*" Margin="0,0,0,10">
      <TextBlock Text="显示名称" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="AliasBox" FontSize="12" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="72,*" Margin="0,0,0,10">
      <TextBlock Text="分组" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="GroupBox" FontSize="12" Watermark="可选，例如 游戏 / VTB / 赛事" />
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="72,*" Margin="0,0,0,10">
      <TextBlock Text="序号" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="NumberBox" FontSize="12" />
    </Grid>

    <!-- V0.6-A 自定义清流：可替换带新 Token 的拉流地址，并修改防盗链请求头。 -->
    <StackPanel Grid.Row="4" x:Name="CustomStreamPanel" IsVisible="False" Spacing="8" Margin="0,2,0,8">
      <TextBlock Text="清流设置（仅自定义清流）" FontSize="11" Foreground="#E6E8EE" />
      <Grid ColumnDefinitions="72,*">
        <TextBlock Text="拉流地址" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="StreamUrlBox" FontSize="11" Watermark="http(s) / rtmp / rtsp / srt 直链" />
      </Grid>
      <Grid ColumnDefinitions="72,*">
        <TextBlock Text="Referer" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="RefererBox" FontSize="11" Watermark="可选，防盗链 Referer" />
      </Grid>
      <Grid ColumnDefinitions="72,*">
        <TextBlock Text="User-Agent" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="UserAgentBox" FontSize="11" Watermark="可选，留空使用内置浏览器 UA" />
      </Grid>
    </StackPanel>

    <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="#F87171" FontSize="11"
               TextWrapping="Wrap" Margin="0,4,0,0" />

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Bottom">
      <Button Content="取消" Click="OnCancel" />
      <Button x:Name="SaveButton" Content="保存" Click="OnSave" Classes="accent" />
    </StackPanel>
  </Grid>
</Window>
