<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiveMonitor.Desktop.ViewModels"
        x:Class="LiveMonitor.Desktop.Views.ConfirmDeleteRecordingWindow"
        Icon="avares://LimoClip/Assets/AppIcon.ico"
        Title="删除录制记录"
        Width="580"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgBase}"
        RequestedThemeVariant="Dark">
  <StackPanel>
    <!-- 标题区 -->
    <StackPanel Margin="20,18,20,10" Spacing="6">
      <TextBlock Text="删除录制记录"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushTextPrimary}" />
      <TextBlock Text="此操作会同时删除录像文件与弹幕文件，且无法恢复。"
                 FontSize="11.5" TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushDanger}" />
    </StackPanel>

    <!-- 记录信息 -->
    <Border Classes="card" Margin="20,0,20,12" Padding="16,14">
      <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
        <TextBlock Grid.Row="0" Text="直播间" FontSize="11"
                   Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RoomTitle}" FontSize="12"
                   Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Row="1" Text="开始时间" FontSize="11"
                   Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StartedAtText}" FontSize="12"
                   Classes="mono" Foreground="{DynamicResource BrushTextSecondary}" />

        <TextBlock Grid.Row="2" Text="视频文件" FontSize="11"
                   Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VideoFileName}" FontSize="12"
                   Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding VideoFilePath}" />

        <TextBlock Grid.Row="3" Text="弹幕文件" FontSize="11"
                   Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DanmakuFileName}" FontSize="12"
                   Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <!-- 操作栏 -->
    <Border BorderBrush="{DynamicResource BrushBorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="取消" Classes="subtle-btn" Click="OnCancelClick" />
        <Button Content="删除记录" Classes="danger-btn" Click="OnDeleteClick" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
