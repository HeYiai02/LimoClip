<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveMonitor.Desktop.Views.TextPromptWindow"
        Title="保存方案"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgBase}">
  <StackPanel>
    <!-- 标题区 -->
    <StackPanel Margin="20,18,20,10" Spacing="4">
      <TextBlock x:Name="PromptText"
                 FontSize="16" FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource BrushTextPrimary}" />
    </StackPanel>

    <!-- 输入 -->
    <Border Classes="card" Margin="20,0,20,12" Padding="16,14">
      <TextBox x:Name="ValueBox" FontSize="12" />
    </Border>

    <!-- 操作栏 -->
    <Border BorderBrush="{DynamicResource BrushBorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="取消" Classes="subtle-btn" Click="OnCancel" />
        <Button Content="确定" Classes="primary-btn" Click="OnOk" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
