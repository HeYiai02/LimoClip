<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveMonitor.Desktop.Views.StartupErrorWindow"
        Icon="avares://LiveMonitor.Desktop/Assets/AppIcon.ico"
        Title="启动失败"
        Width="760" Height="520"
        MinWidth="520" MinHeight="320"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBgBase}">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- 标题区 -->
    <StackPanel Grid.Row="0" Margin="20,18,20,10" Spacing="4">
      <TextBlock Text="主程序启动失败"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushTextPrimary}" />
      <TextBlock Text="完整错误如下，可复制后反馈："
                 FontSize="11.5"
                 Foreground="{DynamicResource BrushTextSecondary}" />
    </StackPanel>

    <!-- 错误详情 -->
    <Border Grid.Row="1" Classes="card" Margin="20,0,20,12" Padding="12">
      <TextBox x:Name="ErrorText"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               FontFamily="{DynamicResource FontMono}"
               FontSize="11.5" />
    </Border>

    <Border Grid.Row="3" BorderBrush="{DynamicResource BrushBorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="复制错误" Classes="ghost-btn" Click="OnCopy" />
        <Button Content="关闭" Classes="primary-btn" Click="OnClose" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
