<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:player="using:LiveMonitor.Desktop.Player"
             xmlns:controls="using:LiveMonitor.Desktop.Controls"
             xmlns:mpv="using:LibMpv.Avalonia"
             x:Class="LiveMonitor.Desktop.Player.MpvPlayerView"
             Background="#05070A"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
  <UserControl.Styles>
    <!-- 音量滑块：默认手柄是大号白圆点（外圈品牌蓝描边），在几乎透明的控制栏上过于抢眼。
         这里把 Semi 主题模板里的手柄圆点缩成 10px 的浅色小圆点，只保留可拖拽的暗示。 -->
    <Style Selector="Slider#VolumeSlider /template/ Border">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="#E6F1F5F9" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid ClipToBounds="True">
    <player:MpvVideoView x:Name="Video" />

    <!-- 弹幕渲染层：只渲染已通过过滤链的弹幕，不参与命中测试，避免吃掉窗格双击/拖拽。
         可见性由 MpvPlayerView 结合「窗格弹幕开关」与「全局渲染总闸」在代码中计算。 -->
    <controls:DanmakuOverlay x:Name="DanmakuLayer"
                             IsVisible="False"
                             Margin="0,0,0,33" />

    <!-- 四态占位层：加载中 / 未开播 / 播放中（隐藏） / 失败 -->
    <Border x:Name="StateOverlay" Background="#D90B0E13">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10"
                  MaxWidth="360">
        <ProgressBar x:Name="LoadingBar"
                     Width="140"
                     Height="3"
                     IsIndeterminate="True"
                     Foreground="{DynamicResource BrushAccent}" />
        <TextBlock x:Name="StateTitle"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextPrimary}"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="StateDetail"
                   FontSize="12"
                   Foreground="{DynamicResource BrushTextSecondary}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" />
        <Button x:Name="RetryButton"
                Classes="primary-btn"
                Content="重新连接"
                IsVisible="False"
                Click="OnRetryClick"
                HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- 悬浮控制栏：几乎透明的暗色渐变 + 一条极轻的分离线，让画面本身仍是主角 -->
    <Border x:Name="ControlBar"
            VerticalAlignment="Bottom"
            Padding="10,4"
            BorderBrush="#14FFFFFF"
            BorderThickness="0,1,0,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#00000000" Offset="0" />
          <GradientStop Color="#29070A10" Offset="0.55" />
          <GradientStop Color="#4D070A10" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    ClipToBounds="True">
          <!-- 主播名/窗格编号已在窗格左上角标题栏展示，底栏只保留画质与实测帧率，避免重复。 -->
          <TextBlock x:Name="QualityText"
                     Text="—"
                     Classes="mono"
                     FontSize="10"
                     Foreground="{DynamicResource BrushTextSecondary}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center"
                    Margin="10,0,4,0">
          <controls:AudioLevelMeter x:Name="AudioMeter"
                                    Width="40"
                                    Height="16"
                                    Margin="0,0,2,0"
                                    VerticalAlignment="Center" />
          <TextBlock Text="音量"
                     FontSize="9.5"
                     Foreground="{DynamicResource BrushTextMuted}"
                     VerticalAlignment="Center" />
          <Slider x:Name="VolumeSlider"
                  Width="48"
                  Minimum="0"
                  Maximum="100"
                  Value="100"
                  TickFrequency="1"
                  IsSnapToTickEnabled="True"
                  VerticalAlignment="Center"
                  ValueChanged="OnVolumeChanged" />
        </StackPanel>

        <Button x:Name="PauseButton"
                Grid.Column="2"
                Classes="ghost-btn"
                Width="24" Height="24"
                Padding="0"
                Margin="2,0,0,0"
                ToolTip.Tip="暂停 / 继续播放"
                Click="OnPauseClick">
          <TextBlock x:Name="PauseIcon"
                     Text="&#xE769;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="13"
                     Foreground="{DynamicResource BrushTextSecondary}"
                     VerticalAlignment="Center" />
        </Button>

        <Button x:Name="RefreshButton"
                Grid.Column="3"
                Classes="ghost-btn"
                Width="24" Height="24"
                Padding="0"
                Margin="2,0,0,0"
                ToolTip.Tip="刷新播放（重新获取直播地址并重连）"
                Click="OnRefreshClick">
          <PathIcon Data="{DynamicResource IconRefresh}"
                    Width="13" Height="13"
                    Foreground="{DynamicResource BrushTextSecondary}" />
        </Button>

        <Button x:Name="MuteButton"
                Grid.Column="4"
                Classes="ghost-btn"
                Width="24" Height="24"
                Padding="0"
                Margin="2,0,0,0"
                ToolTip.Tip="开声"
                Click="OnMuteClick">
          <TextBlock x:Name="MuteIcon"
                     Text="&#xE74F;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="14"
                     Foreground="{DynamicResource BrushTextSecondary}"
                     VerticalAlignment="Center" />
        </Button>

        <ToggleButton x:Name="DanmakuButton"
                      Grid.Column="5"
                      Classes="ghost-btn"
                      Height="24"
                      MinWidth="24"
                      Padding="6,0"
                      Margin="4,0,0,0"
                      FontSize="10"
                      ToolTip.Tip="弹幕开关（关闭渲染后仍参与高能统计）"
                      IsChecked="{Binding IsDanmakuVisible, Mode=TwoWay}">
          <TextBlock Text="弹" FontSize="10.5" VerticalAlignment="Center" />
        </ToggleButton>

        <Button x:Name="CompactButton"
                Grid.Column="6"
                Classes="ghost-btn"
                Height="24"
                Padding="7,0"
                Margin="4,0,0,0"
                FontSize="10"
                FontFamily="{DynamicResource FontMono}"
                Content="60fps"
                Click="OnCompactClick" />
      </Grid>
    </Border>

  </Grid>
</UserControl>
